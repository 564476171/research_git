# Research Git deployment
# 1) Run: python3 scripts/bootstrap-env.py
# 2) Edit only ADMIN_BOOTSTRAP_EMAILS below.
# 3) Run: docker compose up -d --build

# Postgres. POSTGRES_PASSWORD is generated by scripts/bootstrap-env.py.
POSTGRES_USER=research
POSTGRES_PASSWORD=
POSTGRES_DB=research_git
DATABASE_URL=

# Backend services. REDIS_URL is filled by scripts/bootstrap-env.py.
REDIS_URL=redis://redis:6379/0

# Generated secrets. Never rotate MASTER_KEY after saving model API keys.
JWT_SECRET=
MASTER_KEY=

# Platform administrator bootstrap email. Users with this email become global admins on register/login.
ADMIN_BOOTSTRAP_EMAILS=admin@example.com

# Public frontend URL. Global admins can edit this later in the admin console.
PUBLIC_FRONTEND_URL=http://localhost:6288

# Emergency CORS fallback before domain settings are saved in the admin console.
CORS_ORIGINS=http://localhost:6288

# User-uploaded media
MEDIA_ROOT=/app/media
MEDIA_URL=/media
AVATAR_MAX_BYTES=2000000
